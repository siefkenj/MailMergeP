{
    "name": "mailmergep",
    "version": "2.7.0",
    "description": "A Mail Merge extension for Thunderbird",
    "homepage": ".",
    "private": "true",
    "workspaces": [
        "packages/iframe-service",
        "packages/interface",
        "packages/thunderbird-iframe-service",
        "packages/thunderbird-extension",
        "packages/browser-preview"
    ],
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@handsontable/react-wrapper": "^18.1.1",
        "@huggingface/jinja": "^0.5.10",
        "classnames": "2.5.1",
        "easy-peasy": "^6.1.1",
        "handsontable": "^18.1.1",
        "jschardet": "^4.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-localization": "^2.0.6",
        "xlsx": "file:vendor/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.19.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "bestzip": "^4.0.1",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.1",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.2"
    },
    "scripts": {
        "dev": "npm run dev -w browser-preview",
        "build": "npm run build --workspaces",
        "typecheck": "tsc -p .",
        "lint": "eslint .",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "build-addon": "rm -rf addon && cp -rL packages/thunderbird-extension/dist addon && cd addon && bestzip ../addon.zip *",
        "package-addon": "mv addon.zip mailmergep@example.net-latest.xpi",
        "build-and-package": "npm run build && npm run build-addon && echo \"\" && echo BUNDLING $(cat addon/manifest.json |grep '\"version\"') && npm run package-addon"
    },
    "browserslist": [
        "firefox >= 91"
    ]
}
